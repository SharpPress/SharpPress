@page "/admin/sample"
@model SamplePlugin.Pages.FeatureCheckModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sample plugin feature check";
}

<header class="page-header">
    <h1>Sample plugin feature check</h1>
    <a href="/admin/sample" class="btn">Run again</a>
</header>

<p class="alert @(Model.Failed > 0 ? "alert-danger" : "alert-success")" role="status">@Model.Passed passed, @Model.Failed failed, @Model.Skipped skipped</p>

<div class="table-container">
    <table class="table-stack">
        <thead>
            <tr>
                <th>Feature</th>
                <th>Result</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.Results)
            {
                <tr>
                    <td class="cell-title">@result.Feature</td>
                    <td data-label="Result"><span class="badge @(result.Status == "pass" ? "badge-success" : result.Status == "fail" ? "badge-danger" : "badge-warning")">@result.Status</span></td>
                    <td data-label="Details">@result.Detail</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="card-links">
    <a href="/admin/plugin-settings/SamplePlugin">Plugin settings form</a>
    <a href="/sample/page">Public plugin page</a>
    <a href="/sample/hello/World">Route with parameter</a>
    <a href="/sample-api/ping">MVC controller</a>
    <a href="/sample/files/hello.txt">Static file</a>
    <a href="/admin/posts">Create a post titled "forbidden" to see the veto</a>
</p>
