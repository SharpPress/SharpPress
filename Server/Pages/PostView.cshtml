@page "/PostView"
@model SharpPress.Pages.PostViewModel
@inject SharpPress.Services.IFilterPipeline Filters
@{
    Layout = "_SiteLayout";
    ViewData["Title"] = Model.Post?.Title ?? "Post not found";
}

@section Head {
    <meta name="description" content="@(Model.Post?.Excerpt ?? "")" />
    @if (!string.IsNullOrEmpty(Model.Post?.FeaturedImage))
    {
        <meta property="og:image" content="@Model.Post.FeaturedImage" />
    }
    @Html.Raw(Filters.Apply(SharpPress.Services.FilterKeys.PageHead, ""))
}

@if (Model.Post != null)
{
    <article class="article">
        <header>
            <h1>@Filters.Apply(SharpPress.Services.FilterKeys.PostTitle, Model.Post.Title)</h1>
            <p class="field-help">
                @if (Model.Post.PublishedAt.HasValue)
                {
                    <time datetime="@Model.Post.PublishedAt.Value.ToString("yyyy-MM-dd")">@Model.Post.PublishedAt.Value.ToString("MMMM d, yyyy")</time>
                }
                @if (!string.IsNullOrEmpty(Model.Post.AuthorUsername))
                {
                    <span> by @Model.Post.AuthorUsername</span>
                }
            </p>
            @if (!string.IsNullOrEmpty(Model.Post.Excerpt))
            {
                <p>@Filters.Apply(SharpPress.Services.FilterKeys.PostExcerpt, Model.Post.Excerpt)</p>
            }
            @if (!string.IsNullOrEmpty(Model.Post.FeaturedImage))
            {
                <img src="@Model.Post.FeaturedImage" alt="@Model.Post.Title" class="article-image" />
            }
        </header>

        <div class="article-body">
            @Html.Raw(Filters.Apply(SharpPress.Services.FilterKeys.PostContentRender, Model.Post.Content))
        </div>

        <footer class="article-footer">
            <a href="/">Back to home</a>
        </footer>
    </article>
}
else
{
    <div class="status-page">
        <h1>Post not found</h1>
        <p>This post does not exist or is no longer published.</p>
        <p><a href="/">Go to the home page</a></p>
    </div>
}

@Html.Raw(Filters.Apply(SharpPress.Services.FilterKeys.PageFooter, ""))
