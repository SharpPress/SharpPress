@inject IUserService userService
@inject IAdminMenuService adminMenuService

@{
    var title = ViewData["Title"] ?? "Admin";
    var username = (await userService.GetUserAsync(User))?.Username ?? "";
    var currentPath = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant() ?? "";

    var dashboard = (Name: "Dashboard", Icon: @"<svg viewBox=""0 0 24 24""><path d=""M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"" /></svg>", Url: "/admin");

    var content = new List<(string Name, string Icon, string Url)>
    {
        ("Posts", @"<svg viewBox=""0 0 24 24""><path d=""M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"" /><path d=""M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"" /></svg>", "/admin/posts"),
        ("Media", @"<svg viewBox=""0 0 24 24""><rect x=""3"" y=""3"" width=""18"" height=""18"" rx=""2"" /><circle cx=""8.5"" cy=""8.5"" r=""1.5"" /><polyline points=""21 15 16 10 5 21"" /></svg>", "/admin/media"),
        ("Categories", @"<svg viewBox=""0 0 24 24""><path d=""M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"" /></svg>", "/admin/categories"),
        ("Tags", @"<svg viewBox=""0 0 24 24""><path d=""M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"" /><path d=""M7 7h.01"" /></svg>", "/admin/tags")
    };

    var plugins = adminMenuService.GetItems().OrderBy(i => i.Order).Select(i => (Name: i.Name, Icon: i.IconSvg, Url: i.Url)).ToList();
    plugins.Add(("Manage plugins", @"<svg viewBox=""0 0 24 24""><rect x=""3"" y=""3"" width=""7"" height=""7"" /><rect x=""14"" y=""3"" width=""7"" height=""7"" /><rect x=""3"" y=""14"" width=""7"" height=""7"" /><path d=""M17.5 14v7M14 17.5h7"" /></svg>", "/admin/plugins"));

    var site = new List<(string Name, string Icon, string Url)>
    {
        ("Users", @"<svg viewBox=""0 0 24 24""><path d=""M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"" /><circle cx=""9"" cy=""7"" r=""4"" /><path d=""M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"" /></svg>", "/admin/users"),
        ("Settings", @"<svg viewBox=""0 0 24 24""><path d=""M4 6h16M4 12h16M4 18h16"" /><circle cx=""9"" cy=""6"" r=""2"" /><circle cx=""15"" cy=""12"" r=""2"" /><circle cx=""8"" cy=""18"" r=""2"" /></svg>", "/admin/settings")
    };

    var groups = new[]
    {
        (Label: (string?)null, Items: new List<(string Name, string Icon, string Url)> { dashboard }),
        (Label: (string?)"Content", Items: content),
        (Label: (string?)"Plugins", Items: plugins),
        (Label: (string?)"Site", Items: site)
    };

    bool IsCurrent(string url)
    {
        var target = url.TrimEnd('/').ToLowerInvariant();
        return currentPath == target || (target != "/admin" && currentPath.StartsWith(target + "/"));
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - SharpPress</title>
    <script>
        try { const theme = localStorage.getItem("theme"); if (theme) document.documentElement.dataset.theme = theme; } catch { delete document.documentElement.dataset.theme; }
    </script>
    <link rel="stylesheet" href="~/assets/app.css" asp-append-version="true" />
    <script src="~/assets/app.js" asp-append-version="true" defer></script>
</head>
<body>
    <div class="shell">
        <aside class="sidebar" id="sidebar">
            <div class="brand">SharpPress</div>
            <nav aria-label="Admin">
                @foreach (var group in groups)
                {
                    <div class="nav-group">
                        @if (group.Label != null)
                        {
                            <p class="nav-label">@group.Label</p>
                        }
                        <ul>
                            @foreach (var item in group.Items)
                            {
                                <li>
                                    <a href="@item.Url" class="menu-item" aria-current="@(IsCurrent(item.Url) ? "page" : null)">
                                        <span class="menu-icon" aria-hidden="true">@Html.Raw(item.Icon)</span>
                                        @item.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </nav>
            <a href="/" class="menu-item sidebar-end">View site</a>
        </aside>

        <div class="backdrop" data-menu-close></div>

        <main class="main-content">
            <header class="top-bar">
                <button type="button" class="btn menu-toggle" data-menu-toggle aria-controls="sidebar" aria-expanded="false">Menu</button>
                <button type="button" class="btn" data-theme-toggle>Light / dark</button>
                <span class="user-name" id="user-name">@username</span>
                <a href="/logout" class="btn" id="logout-btn">Sign out</a>
            </header>

            <div class="content">
                @if (TempData["Flash"] is string flash)
                {
                    <div class="alert alert-success" role="status">@flash</div>
                }
                @if (TempData["FlashError"] is string flashError)
                {
                    <div class="alert alert-danger" role="alert">@flashError</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <dialog class="dialog" id="confirm-dialog" aria-labelledby="confirm-title">
        <form method="dialog">
            <h2 id="confirm-title">Please confirm</h2>
            <p data-confirm-message></p>
            <div class="actions">
                <button class="btn" value="cancel">Cancel</button>
                <button class="btn btn-danger" value="confirm">Confirm</button>
            </div>
        </form>
    </dialog>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
