@page "/login"
@model SharpPress.Pages.LoginModel
@{
    Layout = "_SiteLayout";
    ViewData["Title"] = "Sign in";
}

<div class="card narrow">
    <h1>Sign in</h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status" dir="auto">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert" dir="auto">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" required autocomplete="username" />
            <span asp-validation-for="Input.Email" class="error-text" dir="auto"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" required autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="error-text" dir="auto"></span>
            <label class="check"><input type="checkbox" data-show-password="Input_Password" /> Show password</label>
        </div>

        @if (Model.ShowTwoFactor)
        {
            <div class="field">
                <label asp-for="Input.TwoFactorCode">Two-step sign in code</label>
                <input asp-for="Input.TwoFactorCode" required autocomplete="one-time-code" inputmode="numeric" maxlength="10" />
                <span asp-validation-for="Input.TwoFactorCode" class="error-text" dir="auto"></span>
            </div>
        }

        <div class="field">
            <label class="check"><input type="checkbox" asp-for="Input.RememberMe" /> Remember me</label>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Sign in</button>
    </form>

    <p class="card-links">
        <a href="/forgot-password">Forgot password?</a>
        <a href="/register@(HttpContext.Request.QueryString)">Create an account</a>
    </p>
</div>
