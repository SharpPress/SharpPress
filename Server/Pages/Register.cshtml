@page "/register"
@model SharpPress.Pages.RegisterModel
@{
    Layout = "_SiteLayout";
    ViewData["Title"] = "Create account";
}

<div class="card narrow">
    <h1>Create account</h1>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="status" dir="auto">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert" dir="auto">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="error-text" dir="auto"></div>

        <div class="field">
            <label asp-for="Input.Username">Username (no spaces)</label>
            <input asp-for="Input.Username" required autocomplete="username" />
            <span asp-validation-for="Input.Username" class="error-text" dir="auto"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" required autocomplete="email" />
            <span asp-validation-for="Input.Email" class="error-text" dir="auto"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" required autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="error-text" dir="auto"></span>
        </div>

        <div class="field">
            <label asp-for="Input.ConfirmPassword">Repeat password</label>
            <input asp-for="Input.ConfirmPassword" required autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="error-text" dir="auto"></span>
            <label class="check"><input type="checkbox" data-show-password="Input_Password Input_ConfirmPassword" /> Show passwords</label>
        </div>

        <div class="field">
            <label class="check"><input type="checkbox" asp-for="Input.AcceptTerms" /> <span>I accept the <a href="/terms" target="_blank">terms and conditions</a></span></label>
            <span asp-validation-for="Input.AcceptTerms" class="error-text" dir="auto"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">Create account</button>
    </form>

    <p class="card-links">
        <a href="/login@(HttpContext.Request.QueryString)">I already have an account</a>
    </p>
</div>
