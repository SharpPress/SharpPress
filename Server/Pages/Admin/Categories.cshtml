@page "/admin/categories"
@using SharpPress.Services.General
@model SharpPress.Pages.CategoriesModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";

    var rows = new List<(Category Category, int Depth)>();

    void Add(IEnumerable<CategoryNode> nodes, int depth)
    {
        foreach (var node in nodes)
        {
            rows.Add((node.Category, depth));
            Add(node.Children, depth + 1);
        }
    }

    Add(Model.CategoryTree, 0);
}

<header class="page-header">
    <h1>Categories</h1>
</header>

<form method="post" asp-page-handler="Create" class="card">
    <h2 class="card-title">New category</h2>
    <div class="field-row">
        <div class="field">
            <label for="category-name">Name</label>
            <input asp-for="NewCategory.Name" id="category-name" required />
        </div>
        <div class="field">
            <label for="category-slug">Web address (optional)</label>
            <input asp-for="NewCategory.Slug" id="category-slug" />
        </div>
        <div class="field">
            <label for="category-parent">Inside</label>
            <select name="NewCategory.ParentId" id="category-parent">
                <option value="0">Top level</option>
                @foreach (var category in Model.Categories.Where(c => c.ParentId == 0))
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="field">
        <label for="category-description">Description (optional)</label>
        <textarea asp-for="NewCategory.Description" id="category-description" rows="2"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Add category</button>
</form>

@if (!rows.Any())
{
    <div class="empty">
        <p>No categories yet. Add one above to group your posts.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="table-stack">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Web address</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td class="cell-title">@(new string('—', row.Depth)) @row.Category.Name</td>
                        <td data-label="Web address" class="cell-muted">/@row.Category.Slug</td>
                        <td data-label="Description" class="cell-muted">@row.Category.Description</td>
                        <td>
                            <div class="actions">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@row.Category.Id" data-confirm="Delete the category &quot;@row.Category.Name&quot;? This cannot be undone.">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
