@page "/admin/users"
@using SharpPress.Services.Database
@model SharpPress.Pages.UsersModel
@inject FeatherDatabase database

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
    var users = (await database.GetPagedByLinq<User>(1, 100, u => true, u => u.Id, true)).ToList();
}

<header class="page-header">
    <h1>Users</h1>
</header>

<div id="user-message" class="alert" role="status" hidden></div>

@if (users.Count == 0)
{
    <div class="empty">
        <p>No users yet. They appear here once they register.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="table-stack">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    var locked = user.LockedUntil.HasValue && user.LockedUntil > DateTime.UtcNow;

                    <tr>
                        <td>
                            <div>
                                <p class="cell-title">@user.Username</p>
                                <p class="field-help">@user.Email</p>
                            </div>
                        </td>
                        <td data-label="Role"><span class="badge">@user.Roles</span></td>
                        <td data-label="Status">
                            <span class="badge @(locked ? "badge-danger" : user.IsActive ? "badge-success" : "")">@(locked ? "Locked" : user.IsActive ? "Active" : "Inactive")</span>
                        </td>
                        <td data-label="Last active" class="cell-muted">@user.LastActive.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="actions">
                                <button type="button" class="btn" data-user="@user.UUID" aria-label="Manage @user.Username">Manage</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<dialog class="dialog" id="user-dialog" aria-labelledby="user-title">
    <h2 id="user-title"></h2>
    <p class="field-help" id="user-email"></p>
    <dl class="details">
        <dt>Role</dt>
        <dd id="user-role"></dd>
        <dt>Status</dt>
        <dd id="user-status"></dd>
        <dt>Last active</dt>
        <dd id="user-last"></dd>
        <dt>ID</dt>
        <dd class="secret" id="user-uuid"></dd>
    </dl>
    <div id="user-feedback" class="alert" role="status" hidden></div>
    <div class="actions" id="user-actions"></div>
    <form method="dialog" class="actions">
        <button class="btn">Close</button>
    </form>
</dialog>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    (() => {
        const dialog = document.getElementById("user-dialog");
        const actions = document.getElementById("user-actions");
        const feedback = document.getElementById("user-feedback");
        const pageMessage = document.getElementById("user-message");
        const set = (id, text) => document.getElementById(id).textContent = text;
        let changed = false;

        const show = (element, text, ok) => {
            element.textContent = text;
            element.className = "alert " + (ok ? "alert-success" : "alert-danger");
            element.hidden = false;
        };

        const load = async uuid => {
            const response = await fetch(`?handler=ViewUser&uuid=${encodeURIComponent(uuid)}`);
            if (!response.ok) throw new Error(`The server answered ${response.status}.`);
            const user = await response.json();

            set("user-title", user.username);
            set("user-email", user.email);
            set("user-role", user.roles);
            set("user-status", user.isLocked ? "Locked" : user.isActive ? "Active" : "Inactive");
            set("user-last", new Date(user.lastActive).toLocaleString());
            set("user-uuid", user.uuid);
            render(user);
        };

        const run = async (user, handler, message) => {
            if (message && !await window.confirmAction(message)) return;

            const data = new FormData();
            data.append("uuid", user.uuid);
            data.append("__RequestVerificationToken", document.querySelector("input[name='__RequestVerificationToken']").value);

            try {
                const response = await fetch(`?handler=${handler}`, { method: "POST", body: data });
                if (!response.ok) throw new Error(`The server answered ${response.status}.`);
                const result = await response.json();

                if (!result.success) {
                    show(feedback, result.message || "The action failed.", false);
                    return;
                }

                changed = true;

                if (handler === "DeleteUser") {
                    dialog.close();
                    return;
                }

                await load(user.uuid);
                show(feedback, result.message, true);
            } catch (error) {
                show(feedback, error.message, false);
            }
        };

        const render = user => {
            actions.replaceChildren();

            const add = (label, handler, message, danger) => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = danger ? "btn btn-danger" : "btn";
                button.textContent = label;
                button.addEventListener("click", () => run(user, handler, message));
                actions.append(button);
            };

            const admin = user.roles === "Admin";

            if (!admin && user.roles === "Banned") add("Unban", "UnbanUser", `Unban ${user.username}?`);
            if (!admin && user.roles !== "Banned") add("Ban", "BanUser", `Ban ${user.username}?`, true);
            add(user.isLocked ? "Unlock" : "Lock for 1 hour", user.isLocked ? "UnlockUser" : "LockUser");
            add("Reset password", "ResetPassword");
            if (user.twoFactorEnabled) add("Turn off two-step sign in", "Disable2FA", `Turn off two-step sign in for ${user.username}?`, true);
            if (!admin) add("Delete user", "DeleteUser", `Delete the user "${user.username}"? This cannot be undone.`, true);
        };

        document.querySelectorAll("[data-user]").forEach(button => button.addEventListener("click", async () => {
            feedback.hidden = true;
            pageMessage.hidden = true;

            try {
                await load(button.dataset.user);
                dialog.showModal();
            } catch (error) {
                show(pageMessage, `Could not load the user. ${error.message}`, false);
            }
        }));

        dialog.addEventListener("close", () => {
            if (changed) location.reload();
        });
    })();
</script>
}
