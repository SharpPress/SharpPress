@page "/admin/posts/{id?}/edit"
@model SharpPress.Pages.PostEditorModel

@{
    Layout = "_AdminLayout";
    var heading = Model.Post.Id == 0 ? "New post" : "Edit post";
    ViewData["Title"] = heading;
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Where(m => !string.IsNullOrEmpty(m)).ToList();
}

<div class="form-page">
    <header class="page-header">
        <h1>@heading</h1>
    </header>

    @if (errors.Any())
    {
        <div class="alert alert-danger" role="alert">
            <p>The post was not saved.</p>
            @foreach (var error in errors)
            {
                <p>@error</p>
            }
        </div>
    }

    <form method="post" id="post-form">
        <input type="hidden" asp-for="Post.Id" />

        <div class="field">
            <label for="post-title">Title</label>
            <input asp-for="Post.Title" id="post-title" required />
        </div>

        <div class="field">
            <label for="post-slug">Web address</label>
            <input asp-for="Post.Slug" id="post-slug" />
            <p class="field-help">Filled in from the title. Leave empty to create it automatically.</p>
        </div>

        <div class="field-row">
            <div class="field">
                <label for="post-type">Type</label>
                <select name="Post.Type" id="post-type">
                    @foreach (PostType type in Enum.GetValues(typeof(PostType)))
                    {
                        <!option value="@((int)type)" selected="@(Model.Post.Type == type)">@type</!option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="Post_Status">Status</label>
                <select name="Post.Status" id="Post_Status">
                    @foreach (PostStatus status in Enum.GetValues(typeof(PostStatus)))
                    {
                        <!option value="@((int)status)" selected="@(Model.Post.Status == status)">@status</!option>
                    }
                </select>
            </div>
        </div>

        <div class="field" id="scheduled-group" hidden="@(Model.Post.Status != PostStatus.Scheduled)">
            <label for="post-scheduled">Publish on</label>
            <input id="post-scheduled" name="Post.ScheduledAt" type="datetime-local" value="@(Model.Post.ScheduledAt?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <div class="field">
            <label for="post-excerpt">Short summary</label>
            <textarea asp-for="Post.Excerpt" id="post-excerpt" rows="3"></textarea>
        </div>

        <div class="field">
            <span id="content-label">Content</span>
            <div class="editor-toolbar" role="toolbar" aria-label="Formatting">
                <button type="button" class="btn" data-command="bold">Bold</button>
                <button type="button" class="btn" data-command="italic">Italic</button>
                <button type="button" class="btn" data-command="underline">Underline</button>
                <button type="button" class="btn" data-command="formatBlock" data-value="H2">Heading</button>
                <button type="button" class="btn" data-command="formatBlock" data-value="H3">Subheading</button>
                <button type="button" class="btn" data-command="formatBlock" data-value="P">Paragraph</button>
                <button type="button" class="btn" data-command="insertUnorderedList">Bullets</button>
                <button type="button" class="btn" data-command="insertOrderedList">Numbers</button>
                <button type="button" class="btn" data-command="formatBlock" data-value="BLOCKQUOTE">Quote</button>
                <button type="button" class="btn" id="insert-link">Link</button>
                <button type="button" class="btn" id="open-media">Image</button>
            </div>
            <div class="editor-area" id="editor-content" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="content-label">@Html.Raw(Model.Post.Content)</div>
            <input type="hidden" asp-for="Post.Content" id="post-content-hidden" />
        </div>

        <div class="field">
            <label for="post-image">Featured image address</label>
            <input asp-for="Post.FeaturedImage" id="post-image" />
        </div>

        @if (Model.AllCategories.Any())
        {
            <fieldset class="field">
                <legend>Categories</legend>
                <div class="checks">
                    @foreach (var category in Model.AllCategories)
                    {
                        <label class="check">
                            <input type="checkbox" name="SelectedCategoryIds" value="@category.Id" checked="@Model.SelectedCategoryIds.Contains(category.Id)" />
                            @category.Name
                        </label>
                    }
                </div>
            </fieldset>
        }

        @if (Model.AllTags.Any())
        {
            <fieldset class="field">
                <legend>Tags</legend>
                <div class="checks">
                    @foreach (var tag in Model.AllTags)
                    {
                        <label class="check">
                            <input type="checkbox" name="SelectedTagIds" value="@tag.Id" checked="@Model.SelectedTagIds.Contains(tag.Id)" />
                            @tag.Name
                        </label>
                    }
                </div>
            </fieldset>
        }

        @foreach (var field in Model.MetaFields)
        {
            Model.Meta.TryGetValue(field.Key, out var metaValue);
            var fieldId = "meta-" + field.Key.Replace('.', '-');

            <div class="field">
                @if (field.Type == SharpPress.Services.MetaFieldType.Checkbox)
                {
                    <label class="check">
                        <input type="checkbox" name="Meta[@field.Key]" value="true" checked="@(metaValue == "true")" />
                        @field.Label
                    </label>
                }
                else if (field.Type == SharpPress.Services.MetaFieldType.TextArea)
                {
                    <label for="@fieldId">@field.Label</label>
                    <textarea id="@fieldId" name="Meta[@field.Key]">@metaValue</textarea>
                }
                else
                {
                    <label for="@fieldId">@field.Label</label>
                    <input id="@fieldId" type="@(field.Type == SharpPress.Services.MetaFieldType.Number ? "number" : field.Type == SharpPress.Services.MetaFieldType.Url ? "url" : "text")" name="Meta[@field.Key]" value="@metaValue" />
                }
                @if (!string.IsNullOrEmpty(field.Description))
                {
                    <p class="field-help">@field.Description</p>
                }
            </div>
        }

        <div class="actions">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/admin/posts" class="btn">Cancel</a>
        </div>
    </form>
</div>

<dialog class="dialog dialog-wide" id="media-dialog" aria-labelledby="media-title">
    <h2 id="media-title">Choose an image</h2>
    <div class="media-grid">
        @foreach (var media in Model.MediaItems.Where(m => m.MediaType == "image"))
        {
            var preview = string.IsNullOrEmpty(media.ThumbnailPath) ? "/media/" + media.FilePath : "/media/thumbnails/" + media.ThumbnailPath;
            <button type="button" class="media-tile" data-url="/media/@media.FilePath" data-alt="@media.AltText">
                <img src="@preview" alt="@media.AltText" />
                <span>@media.FileName</span>
            </button>
        }
    </div>
    @if (!Model.MediaItems.Any(m => m.MediaType == "image"))
    {
        <p class="field-help">No images yet. Upload one on the Media page first.</p>
    }
    <form method="dialog" class="actions">
        <button class="btn">Close</button>
    </form>
</dialog>

@section Scripts {
<script>
    (() => {
        const form = document.getElementById("post-form");
        const editor = document.getElementById("editor-content");
        const title = document.getElementById("post-title");
        const slug = document.getElementById("post-slug");
        const status = document.getElementById("Post_Status");
        const media = document.getElementById("media-dialog");
        let slugFollowsTitle = !slug.value;
        let range = null;

        const restore = () => {
            editor.focus();
            if (!range) return;
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
        };

        document.addEventListener("selectionchange", () => {
            const selection = window.getSelection();
            if (selection.rangeCount && editor.contains(selection.anchorNode)) range = selection.getRangeAt(0).cloneRange();
        });

        document.querySelectorAll("[data-command]").forEach(button => button.addEventListener("click", () => {
            restore();
            document.execCommand(button.dataset.command, false, button.dataset.value ?? null);
        }));

        document.getElementById("insert-link").addEventListener("click", () => {
            const url = prompt("Link address");
            if (!url) return;
            restore();
            document.execCommand("createLink", false, url);
        });

        document.getElementById("open-media").addEventListener("click", () => media.showModal());

        media.querySelectorAll(".media-tile").forEach(tile => tile.addEventListener("click", () => {
            const image = document.createElement("img");
            image.src = tile.dataset.url;
            image.alt = tile.dataset.alt ?? "";
            media.close();
            restore();
            document.execCommand("insertHTML", false, image.outerHTML);
        }));

        form.addEventListener("submit", () => {
            document.getElementById("post-content-hidden").value = editor.innerHTML;
        });

        slug.addEventListener("input", () => slugFollowsTitle = !slug.value);

        title.addEventListener("input", () => {
            if (!slugFollowsTitle) return;
            slug.value = title.value.toLowerCase()
                .replace(/[^a-z0-9\s-]/g, "")
                .replace(/[\s-]+/g, "-")
                .replace(/^-+|-+$/g, "");
        });

        status.addEventListener("change", () => {
            document.getElementById("scheduled-group").hidden = status.value !== "2";
        });
    })();
</script>
}
