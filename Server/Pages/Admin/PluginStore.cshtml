@page "/admin/plugins/store"
@model SharpPress.Pages.PluginStoreModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Plugin store";
}

<header class="page-header">
    <h1>Plugin store</h1>
    <a href="/admin/plugins" class="btn">Back to plugins</a>
</header>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <p>@Model.ErrorMessage</p>
        <a href="/admin/plugins/store">Reload the store</a>
    </div>
}
else if (!Model.Plugins.Any())
{
    <div class="empty">
        <p>The store has no plugins right now. Try again later, or upload a plugin file from the Plugins page.</p>
    </div>
}
else
{
    <div class="media-grid store-grid">
        @foreach (var plugin in Model.Plugins)
        {
            <article class="media-card media-body store-card">
                <h2 class="card-title">@plugin.Name</h2>
                <p class="field-help">Version @plugin.Version by @plugin.Author</p>
                <p>@plugin.Description</p>
                <div class="actions">
                    @if (Model.IncompatiblePlugins.Contains(plugin))
                    {
                        <span class="badge badge-warning">Needs SharpPress @plugin.MinVersion</span>
                    }
                    else if (Model.InstalledPlugins.Contains(plugin))
                    {
                        <span class="badge badge-success">Installed</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Install" data-busy>
                            <input type="hidden" name="id" value="@plugin.Id" />
                            <button type="submit" class="btn btn-primary" aria-label="Install @plugin.Name">Install</button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll("form[data-busy]").forEach(form => form.addEventListener("submit", () => {
        const button = form.querySelector("button");
        button.textContent = "Installing…";
        button.disabled = true;
    }));
</script>
}
