@page "/admin/posts"
@model SharpPress.Pages.PostsModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Posts";
}

<header class="page-header">
    <h1>Posts</h1>
    <a href="/admin/posts/0/edit" class="btn btn-primary">New post</a>
</header>

@if (!Model.Posts.Any())
{
    <div class="empty">
        <p>No posts yet. Write your first post to see it here.</p>
        <a href="/admin/posts/0/edit" class="btn">Write a post</a>
    </div>
}
else
{
    <div class="table-container">
        <table class="table-stack">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Author</th>
                    <th>Last changed</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.Posts.OrderByDescending(p => p.UpdatedAt))
                {
                    var statusClass = post.Status switch
                    {
                        PostStatus.Draft => "badge-warning",
                        PostStatus.Published => "badge-success",
                        PostStatus.Scheduled => "badge-primary",
                        _ => ""
                    };
                    var name = string.IsNullOrWhiteSpace(post.Title) ? "Untitled" : post.Title;

                    <tr>
                        <td class="cell-title">@name</td>
                        <td data-label="Type">@post.Type</td>
                        <td data-label="Status"><span class="badge @statusClass">@post.Status</span></td>
                        <td data-label="Author" class="cell-muted">@post.AuthorUsername</td>
                        <td data-label="Last changed" class="cell-muted">@post.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div class="actions">
                                <a href="/admin/posts/@post.Id/edit" class="btn">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@post.Id" data-confirm="Delete the post &quot;@name&quot;? This cannot be undone.">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
