@page "/admin/media"
@model SharpPress.Pages.MediaModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Media";
}

<header class="page-header">
    <h1>Media</h1>
</header>

<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="card inline-form" id="upload-form">
    <div class="field">
        <label for="upload-files">Choose files, or drop them on this box</label>
        <input type="file" id="upload-files" name="uploadedFiles" multiple required accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.csv" />
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

@if (!Model.MediaItems.Any())
{
    <div class="empty">
        <p>No files yet. Choose a file above and press Upload.</p>
    </div>
}
else
{
    <div class="field">
        <label for="media-filter">Show</label>
        <select id="media-filter">
            <option value="all">All files</option>
            <option value="image">Images</option>
            <option value="video">Videos</option>
            <option value="audio">Audio</option>
            <option value="document">Documents</option>
        </select>
    </div>

    <div class="media-grid">
        @foreach (var media in Model.MediaItems.OrderByDescending(m => m.CreatedAt))
        {
            <article class="media-card" data-type="@media.MediaType">
                @if (media.MediaType == "image")
                {
                    var preview = string.IsNullOrEmpty(media.ThumbnailPath) ? $"/media/{media.FilePath}" : $"/media/thumbnails/{media.ThumbnailPath}";
                    <img class="media-preview" src="@preview" alt="@media.AltText" loading="lazy" />
                }
                else
                {
                    <div class="media-preview file-preview">@media.MediaType</div>
                }
                <div class="media-body">
                    <p class="cell-title">@media.FileName</p>
                    <p class="field-help">@(media.FileSize < 1024 * 1024 ? $"{media.FileSize / 1024} KB" : $"{media.FileSize / 1024.0 / 1024.0:F1} MB")</p>
                    <div class="actions">
                        <a class="btn" href="/media/@media.FilePath" target="_blank" rel="noopener">Open</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@media.Id" data-confirm="Delete the file &quot;@media.FileName&quot;? This cannot be undone.">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
}

@section Scripts {
<script>
    (() => {
        const form = document.getElementById("upload-form");
        const input = document.getElementById("upload-files");
        const filter = document.getElementById("media-filter");

        form.addEventListener("dragover", event => event.preventDefault());

        form.addEventListener("drop", event => {
            event.preventDefault();
            input.files = event.dataTransfer.files;
            form.requestSubmit();
        });

        filter?.addEventListener("change", () => {
            document.querySelectorAll(".media-card").forEach(card => {
                card.hidden = filter.value !== "all" && card.dataset.type !== filter.value;
            });
        });
    })();
</script>
}
