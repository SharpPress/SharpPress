@page "/admin/plugins"
@model SharpPress.Pages.PluginsModel
@inject SharpPress.Services.PluginManager pluginManager
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Plugins";
    var plugins = pluginManager.GetLoadedPlugins();
}

<header class="page-header">
    <h1>Plugins</h1>
    <a href="/admin/plugins/store" class="btn">Browse the store</a>
</header>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")" role="status">@Model.StatusMessage</div>
}

<form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="card inline-form">
    <div class="field">
        <label for="plugin-file">Add a plugin from your computer (.dll)</label>
        <input type="file" id="plugin-file" name="pluginFile" accept=".dll" required />
    </div>
    <button type="submit" class="btn btn-primary">Upload plugin</button>
</form>

@if (plugins.Count == 0)
{
    <div class="empty">
        <p>No plugins installed. Upload one above or pick one from the store.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="table-stack">
            <thead>
                <tr>
                    <th>Plugin</th>
                    <th>Version</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var plugin in plugins)
                {
                    var info = plugin.Value;
                    var enabled = pluginManager.IsPluginEnabled(info.Name);
                    var failed = !string.IsNullOrEmpty(info.Error);

                    <tr>
                        <td>
                            <div>
                                <p class="cell-title">@info.Name</p>
                                <p class="field-help">@(string.IsNullOrEmpty(info.Description) ? "No description" : info.Description)</p>
                                @if (failed)
                                {
                                    <p class="error-text">@info.Error</p>
                                }
                            </div>
                        </td>
                        <td data-label="Version" class="cell-muted">@info.Version</td>
                        <td data-label="Author" class="cell-muted">@(info.Author ?? "Unknown")</td>
                        <td data-label="Status">
                            <span class="badge @(failed ? "badge-danger" : enabled ? "badge-success" : "")">@(failed ? "Failed" : enabled ? "On" : "Off")</span>
                        </td>
                        <td>
                            <div class="actions">
                                <form method="post" asp-page-handler="@(enabled ? "Disable" : "Enable")">
                                    <input type="hidden" name="name" value="@info.Name" />
                                    <button type="submit" class="btn">@(enabled ? "Turn off" : "Turn on")</button>
                                </form>
                                <form method="post" asp-page-handler="Remove" data-confirm="Remove the plugin &quot;@info.Name&quot; and delete its files?">
                                    <input type="hidden" name="name" value="@info.Name" />
                                    <button type="submit" class="btn btn-danger">Remove</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
