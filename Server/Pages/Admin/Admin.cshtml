@page "/admin"
@model SharpPress.Pages.AdminModel
@inject SharpPress.Services.IDashboardService _dashboardService

@using System.Text.RegularExpressions

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";

    var logFile = System.IO.Path.Combine(AppContext.BaseDirectory, "logs", "latest.log");
    var logs = System.IO.File.Exists(logFile)
        ? System.IO.File.ReadLines(logFile).TakeLast(200).ToArray()
        : Array.Empty<string>();
    var logLevel = new Regex(@"\[(?<level>INFO|ERROR|WARNING|SECURITY)\]");

    var status = new (string Label, string Value)[]
    {
        ("Running for", Model.Uptime),
        ("Processor", Model.CpuUsage + "%"),
        ("Memory", Model.MemoryMB + " MB"),
        ("Users", Model.Users.ToString()),
        ("Plugins", Model.ActivePlugins.ToString()),
        ("Disk", $"{Model.DiskUsedGB} of {Model.DiskTotalGB} GB"),
        ("Network received", Model.NetReceivedMB + " MB"),
        ("Network sent", Model.NetSentMB + " MB")
    };
}

<header class="page-header">
    <h1>Dashboard</h1>
    <a href="/admin/posts/0/edit" class="btn btn-primary">New post</a>
</header>

<section class="card">
    <h2 class="card-title">Server</h2>
    <dl class="details">
        @foreach (var item in status)
        {
            <dt>@item.Label</dt>
            <dd>@item.Value</dd>
        }
    </dl>
</section>

@foreach (var widget in _dashboardService.Widgets)
{
    <section class="card">
        <h2 class="card-title">@widget.Title</h2>
        @Html.Raw(await widget.Render())
    </section>
}

<details class="card">
    <summary class="card-title">Server log</summary>
    @if (logs.Length == 0)
    {
        <p class="field-help">No log entries yet.</p>
    }
    else
    {
        <div class="log" tabindex="0">
            @foreach (var log in logs)
            {
                var level = logLevel.Match(log).Groups["level"].Value;
                <p class="@(level == "ERROR" ? "error-text" : level == "WARNING" ? "warning-text" : null)">@log</p>
            }
        </div>
    }
</details>
