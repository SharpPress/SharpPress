@page "/admin/tags"
@model SharpPress.Pages.TagsModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tags";
}

<header class="page-header">
    <h1>Tags</h1>
</header>

<form method="post" asp-page-handler="Create" class="card inline-form">
    <div class="field">
        <label for="tag-name">Name</label>
        <input asp-for="NewTag.Name" id="tag-name" required />
    </div>
    <div class="field">
        <label for="tag-slug">Web address (optional)</label>
        <input asp-for="NewTag.Slug" id="tag-slug" />
    </div>
    <button type="submit" class="btn btn-primary">Add tag</button>
</form>

@if (!Model.Tags.Any())
{
    <div class="empty">
        <p>No tags yet. Add one above to label your posts.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="table-stack">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Web address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tag in Model.Tags)
                {
                    <tr>
                        <td class="cell-title">@tag.Name</td>
                        <td data-label="Web address" class="cell-muted">/@tag.Slug</td>
                        <td>
                            <div class="actions">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@tag.Id" data-confirm="Delete the tag &quot;@tag.Name&quot;? This cannot be undone.">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
