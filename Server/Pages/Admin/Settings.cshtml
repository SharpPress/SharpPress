@page "/admin/settings"
@model SharpPress.Pages.SettingsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";

    var timezones = new List<string> { "UTC", "EST", "PST" };
    if (!string.IsNullOrEmpty(Model.Input.Timezone) && !timezones.Contains(Model.Input.Timezone))
    {
        timezones.Add(Model.Input.Timezone);
    }
}

<div class="form-page">
    <header class="page-header">
        <h1>Settings</h1>
    </header>

    @if (TempData["SuccessMessage"] is string saved)
    {
        <div class="alert alert-success" role="status">@saved</div>
    }
    @if (TempData["ErrorMessage"] is string failed)
    {
        <div class="alert alert-danger" role="alert">@failed</div>
    }

    <nav class="section-nav" aria-label="Settings sections">
        <a class="btn" href="#general">General</a>
        <a class="btn" href="#security">Security</a>
        <a class="btn" href="#advanced">Advanced</a>
    </nav>

    <form method="post">
        <section class="card" id="general">
            <h2 class="card-title">General</h2>
            <div class="field">
                <label asp-for="Input.SiteName">Site name</label>
                <input type="text" asp-for="Input.SiteName" />
            </div>
            <div class="field">
                <label asp-for="Input.SiteDescription">Site description</label>
                <input type="text" asp-for="Input.SiteDescription" />
            </div>
            <div class="field">
                <label asp-for="Input.SiteUrl">Site address</label>
                <input type="text" asp-for="Input.SiteUrl" placeholder="https://example.com" />
            </div>
            <div class="field-row">
                <div class="field">
                    <label asp-for="Input.AdminEmail">Contact email</label>
                    <input type="email" asp-for="Input.AdminEmail" />
                </div>
                <div class="field">
                    <label asp-for="Input.Timezone">Time zone</label>
                    <select asp-for="Input.Timezone">
                        @foreach (var zone in timezones)
                        {
                            <option value="@zone">@zone</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field">
                <label asp-for="Input.FooterText">Footer text</label>
                <input type="text" asp-for="Input.FooterText" />
            </div>
        </section>

        <section class="card" id="security">
            <h2 class="card-title">Security</h2>
            <div class="field">
                <label class="check"><input type="checkbox" asp-for="Input.ForceHttps" /> Always use HTTPS</label>
                <label class="check"><input type="checkbox" asp-for="Input.AllowRegistration" /> Let visitors create accounts</label>
                <label class="check"><input type="checkbox" asp-for="Input.Require2FA" /> Require two-step sign in for administrators</label>
            </div>
            <div class="field">
                <label asp-for="Input.SessionTimeout">Sign out after this many minutes of inactivity</label>
                <input type="number" asp-for="Input.SessionTimeout" min="0" />
            </div>
        </section>

        <section class="card" id="advanced">
            <h2 class="card-title">Advanced</h2>
            <div class="field">
                <label class="check"><input type="checkbox" asp-for="Input.EnableCache" /> Cache pages and data</label>
                <label class="check"><input type="checkbox" asp-for="Input.MaintenanceMode" /> Maintenance mode (visitors cannot use the site)</label>
            </div>
            <div class="field">
                <label asp-for="Input.CustomCss">Custom CSS</label>
                <textarea asp-for="Input.CustomCss" rows="6"></textarea>
            </div>
        </section>

        <div class="actions">
            <button type="submit" class="btn btn-primary">Save settings</button>
        </div>
    </form>
</div>
