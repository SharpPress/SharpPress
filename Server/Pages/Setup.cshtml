@page "/setup"
@model SharpPress.Pages.SetupModel
@{
    Layout = "_SiteLayout";
    ViewData["Title"] = "Setup";

    var heading = Model.Step switch
    {
        1 => "Connect the database",
        2 => "Create your account",
        _ => "Finish your site"
    };
}

<div class="card narrow">
    <p class="steps">Step @Model.Step of 3</p>
    <h1>@heading</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    @if (Model.Step == 1)
    {
        <form method="post" asp-page-handler="Step1">
            <div class="field">
                <label asp-for="Step1.Host">Database server</label>
                <input asp-for="Step1.Host" required />
                <span asp-validation-for="Step1.Host" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step1.Port">Port</label>
                <input asp-for="Step1.Port" required />
                <span asp-validation-for="Step1.Port" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step1.Database">Database name</label>
                <input asp-for="Step1.Database" required />
                <span asp-validation-for="Step1.Database" class="error-text"></span>
                <p class="field-help">Created automatically if it does not exist.</p>
            </div>
            <div class="field">
                <label asp-for="Step1.Username">Database user</label>
                <input asp-for="Step1.Username" required autocomplete="off" />
                <span asp-validation-for="Step1.Username" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step1.Password">Database password</label>
                <input asp-for="Step1.Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Step1.Password" class="error-text"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Connect and continue</button>
        </form>
    }
    else if (Model.Step == 2)
    {
        <form method="post" asp-page-handler="Step2">
            <div class="field">
                <label asp-for="Step2.SiteName">Site name</label>
                <input asp-for="Step2.SiteName" required />
                <span asp-validation-for="Step2.SiteName" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step2.SiteDescription">Site description (optional)</label>
                <textarea asp-for="Step2.SiteDescription" rows="2"></textarea>
                <span asp-validation-for="Step2.SiteDescription" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step2.Username">Your username</label>
                <input asp-for="Step2.Username" required autocomplete="username" />
                <span asp-validation-for="Step2.Username" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step2.Email">Your email</label>
                <input asp-for="Step2.Email" required autocomplete="email" />
                <span asp-validation-for="Step2.Email" class="error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Step2.Password">Password</label>
                <input asp-for="Step2.Password" required autocomplete="new-password" />
                <span asp-validation-for="Step2.Password" class="error-text"></span>
                <p class="field-help">At least 8 characters with an uppercase letter, a lowercase letter, a number and a symbol.</p>
            </div>
            <div class="field">
                <label asp-for="Step2.ConfirmPassword">Repeat password</label>
                <input asp-for="Step2.ConfirmPassword" required autocomplete="new-password" />
                <span asp-validation-for="Step2.ConfirmPassword" class="error-text"></span>
                <label class="check"><input type="checkbox" data-show-password="Step2_Password Step2_ConfirmPassword" /> Show passwords</label>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Create account and continue</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Step3">
            <div class="field">
                <label asp-for="Step3.SiteUrl">Site address</label>
                <input asp-for="Step3.SiteUrl" placeholder="https://example.com" required />
                <span asp-validation-for="Step3.SiteUrl" class="error-text"></span>
                <p class="field-help">Used for links in feeds, the sitemap and emails.</p>
            </div>
            <div class="field">
                <label asp-for="Step3.Timezone">Time zone</label>
                <select asp-for="Step3.Timezone">
                    <option value="UTC">UTC</option>
                    <option value="EST">EST</option>
                    <option value="PST">PST</option>
                </select>
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" asp-for="Step3.AllowRegistration" /> Let visitors create accounts</label>
                <label class="check"><input type="checkbox" asp-for="Step3.ForceHttps" /> Always use HTTPS</label>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Finish setup</button>
        </form>
    }
</div>
